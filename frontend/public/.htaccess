# SPA fallback for React Router (Hostinger / LiteSpeed / Apache)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't touch real files/folders (assets, uploads, logo, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> React app
  RewriteRule ^ /index.html [L]
</IfModule>
